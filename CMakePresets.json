{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development with tests",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "sanitizers",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/sanitizers",
      "cacheVariables": { "STRINGKERNEL_SANITIZERS": true },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "coverage",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": { "STRINGKERNEL_COVERAGE": true },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug" },
    { "name": "sanitizers", "configurePreset": "sanitizers", "configuration": "Debug" },
    { "name": "coverage", "configurePreset": "coverage", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "sanitizers", "configurePreset": "sanitizers", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
